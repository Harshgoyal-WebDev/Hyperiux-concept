  "interaction": {
    "grass": {
      "targets": "every GPnnnn_* node (variants Grass_Clump_A-D, Grass_Shoreline_A)",
      "method": "vertex shader bend (onBeforeCompile) on InstancedMesh per variant",
      "data": "Each blade is a separate strip: 4 segments (2 verts/row) + tip vertex, 7 tris. uv.y = 0 at the root and 1 at the tip; the root sits at local y = -0.02 (slightly sunk). Bend offset = cursorPushDir * strength * pow(uv.y, 1.5-2.0) so roots stay anchored; spring back with a damped spring on a per-instance strength uniform/attribute. uv.x is 0/1 across the blade.",
      "vertexColor": "COLOR_0 = per-blade tint (dry blades yellower). three.js enables vertexColors automatically."
    },
    "bushes": {
      "targets": "PBnn_Bush_X_LeafCluster_NN",
      "method": "per-cluster rotation sway around the node origin (the attachment point on the stem), 2-6 degrees, plus optional low-amplitude vertex ripple driven by distance from the cluster centre",
      "pivots": "Each cluster node origin = where it attaches to its stem; the leaf cards sit around a centre ~0.3 x clusterRadius beyond the pivot. Stems stay static."
    },
    "trees": {
      "targets": "PTnn_Tree_X_LeafCluster_NN (and optionally PTnn_Tree_X_Branch_NN for a very subtle secondary sway)",
      "method": "rotate nearby leaf clusters about their own origin (attachment point on the branch/twig tip) by a few degrees with a spring; or vertex-shader flutter weighted by distance from the node origin",
      "rules": "Never move the Trunk node. Clusters are children of branches, so a branch sway carries its clusters.",
      "raycastHint": "Raycast against leaf-cluster meshes (alpha cards) or use cluster bounding spheres for proximity tests; cards are double-sided alpha-mask quads (3x2 verts, 4 tris each)."
    },
    "leafCards": {
      "normals": "Custom normals blended 70% toward the cluster centre's outward direction for soft canopy shading; keep geometry normals as exported (do not recompute).",
      "vertexColor": "COLOR_0 = tint x baked ambient occlusion (darker toward cluster core and underside)."
    }
  },
  "materials": {
    "M_Terrain": "opaque, macro albedo + tiled detail normal, roughness 0.93, single-sided",
